{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "css.d.ts",
    "uniwind-types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "doctor-dashboard"
  ]
}
